<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.ffmx.painel" />
    </queries>

    <application android:theme="@style/AppTheme" android:label="Gerador FFMX" android:icon="@drawable/ffmx_logo" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".SenhaProvider"
            android:authorities="com.ffmx.gerador.senha"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
